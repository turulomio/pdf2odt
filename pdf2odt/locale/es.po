msgid "Converts a pdf to a LibreOffice Writer document with pages as images"
msgstr "Convierte un pdf a un documento de LibreOffice Writer con sus páginas como imágenes"

msgid "Developed by Mariano Muñoz 2019-{}"
msgstr "Desarrollado por Mariano Muñoz 2019-{}"

msgid "PDF file to convert"
msgstr "Fichero PDF a convertir"

msgid "Sets DPI image resolution. Default is 300"
msgstr "Establece la resolución de la imagen en DPI. Por defecto es 300"

msgid "Extracts text with page.get_text() or OCR and inserts result after image in ODT document"
msgstr "Extrae texto con page.get_text() u OCR e inserta el resultado tras la imagen en el documento ODT"

msgid "Output odt file"
msgstr "Fichero odt de salida"

msgid "ODT generation took {}"
msgstr "La generación del ODT tardó {}"

msgid "Filename to convert is not a PDF document"
msgstr "El fichero a convertir no es un documento PDF"

msgid "Detected {} pages in {}"
msgstr "Se han detectado {} páginas en {}"

msgid "Converting PDF to ODT"
msgstr "Convirtiendo el PDF a ODT"

msgid "Converting {} to {} using pdf2odt-{}"
msgstr "Convirtiendo {} a {} usando pdf2odt-{}"
