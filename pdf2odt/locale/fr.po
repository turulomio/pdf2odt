msgid "Converts a pdf to a LibreOffice Writer document with pages as images"
msgstr "Convertit un pdf en document LibreOffice Writer avec les pages sous forme d'images"

msgid "Developed by Mariano Muñoz 2019-{}"
msgstr "Développé par Mariano Muñoz 2019-{}"

msgid "PDF file to convert"
msgstr "Fichier PDF à convertir"

msgid "Sets DPI image resolution. Default is 300"
msgstr "Définit la résolution de l'image en DPI. Par défaut 300"

msgid "Extracts text with page.get_text() or OCR and inserts result after image in ODT document"
msgstr "Extrait le texte avec page.get_text() ou OCR et insère le résultat après l'image dans le document ODT"

msgid "Output odt file"
msgstr "Fichier odt de sortie"

msgid "ODT generation took {}"
msgstr "La génération de l'ODT a pris {}"

msgid "Filename to convert is not a PDF document"
msgstr "Le fichier à convertir n'est pas un document PDF"

msgid "Detected {} pages in {}"
msgstr "{} pages détectées dans {}"

msgid "Converting PDF to ODT"
msgstr "Conversion du PDF en ODT"

msgid "Converting {} to {} using pdf2odt-{}"
msgstr "Conversion de {} en {} avec pdf2odt-{}"
